{
  "name": "@willet/mcp",
  "version": "0.0.0",
  "description": "Willet MCP server — local stdio transport",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "willet-mcp": "bin/willet-mcp.js",
    "willet-export": "bin/willet-export.js",
    "willet-import": "bin/willet-import.js"
  },
  "files": [
    "dist/",
    "bin/",
    "views/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barmore-Genc/willet.git"
  },
  "homepage": "https://github.com/Barmore-Genc/willet",
  "bugs": {
    "url": "https://github.com/Barmore-Genc/willet/issues"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "clean": "rm -rf dist views",
    "check": "tsc --noEmit",
    "build": "node build.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "1.29.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@willet/shared": "workspace:*",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "node-stream-zip": "^1.16.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "ulid": "^3.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
