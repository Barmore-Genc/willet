{
  "name": "@willet/server",
  "version": "0.0.0",
  "description": "Willet HTTP server — deployed version with OAuth auth",
  "type": "module",
  "main": "dist/index.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@willet/api-spec": "workspace:*",
    "@willet/shared": "workspace:*",
    "express": "^5.2.1",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
